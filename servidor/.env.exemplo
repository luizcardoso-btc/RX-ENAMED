# Copie para .env (ou cadastre no painel da hospedagem) e preencha.
NODE_ENV=production
PORT=3000
# Endereço público do site, sem barra no final. É para onde o Mercado Pago manda os avisos de pagamento.
URL_BASE=https://www.rxenamed.com.br
# Banco Postgres (Supabase, Neon, Railway, Render…).
DATABASE_URL=postgres://usuario:senha@host:5432/rxenamed
# Mercado Pago > Suas integrações > (sua aplicação) > Credenciais de produção.
MP_ACCESS_TOKEN=APP_USR-...
MP_PUBLIC_KEY=APP_USR-...
# Mercado Pago > Suas integrações > (sua aplicação) > Webhooks > assinatura secreta.
MP_WEBHOOK_SECRET=...
# Nome que aparece na fatura do cartão (até 13 caracteres).
MP_DESCRICAO_FATURA=RXENAMED
# E-mails que viram administradores ao se cadastrar.
ADMIN_EMAILS=luizcardoso476@gmail.com
# E-mails automáticos (https://resend.com, plano grátis de 3.000 e-mails/mês). Sem chave, os e-mails só ficam registrados.
RESEND_API_KEY=re_...

# IA do simulador clínico, da busca médica e das correções (Claude). Sem a chave, esses recursos ficam desligados.
ANTHROPIC_API_KEY=sk-ant-...
# IA_MODELO=claude-opus-5-5
# Interações com a IA por dia: plano pago e plano gratuito.
# IA_LIMITE_DIA_PAGO=300
# IA_LIMITE_DIA_GRATIS=15
EMAIL_REMETENTE=RX ENAMED <contato@rxenamed.com.br>
EMAIL_RESPONDER_PARA=luizcardoso476@gmail.com
# Segurança e documentos legais
ADMIN_EXIGIR_2FA=true
LEGAL_EMPRESA=RX ENAMED
LEGAL_DOCUMENTO=CNPJ 00.000.000/0001-00
LEGAL_EMAIL=luizcardoso476@gmail.com
# DATABASE_SSL=true  (só se usar a URL pública do banco; a interna do Railway não precisa)
